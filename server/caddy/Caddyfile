# ============================================================
# ax-stack reverse proxy (Caddy) — 도메인 연결 + 자동 HTTPS
# ------------------------------------------------------------
# DNS A레코드(ax-stack.com / www)가 이 서버를 가리키므로
# Caddy가 Let's Encrypt 인증서를 자동 발급/갱신합니다.
# ============================================================

ax-stack.com, www.ax-stack.com {
	reverse_proxy landing:80
}

# 주의: `http:// { reverse_proxy ... }` catch-all 블록은 두지 않는다.
# 80포트 전체를 프록시하면 Let's Encrypt HTTP-01 챌린지(/.well-known/acme-challenge/)
# 까지 가로채 새 서브도메인 인증서 발급이 실패한다. (각 사이트 블록은 Caddy가
# 자동으로 http→https 리다이렉트 + 인증서 자동 발급을 처리한다.)

# ============================================================
# 서브도메인 포트폴리오 — <id>.ax-stack.com → reverse_proxy <id>-web:80
# 와일드카드 A레코드(*.ax-stack.com)가 서버를 가리키므로
# 블록만 추가하면 Caddy가 접속 시 인증서를 자동 발급한다.
# ============================================================

hello.ax-stack.com {
	reverse_proxy hello-web:80
}

# drops-rag (BMAD RAG 챗봇) — on-demand: 접속 시 sablier가 group=rag 기상, idle 10m 후 종료
rag.ax-stack.com {
	route {
		sablier http://sablier:10000 {
			group rag
			session_duration 10m
			dynamic {
				display_name "DROPS RAG"
				theme ghost
				refresh_frequency 5s
			}
		}
		reverse_proxy rag-web:3000
	}
}
